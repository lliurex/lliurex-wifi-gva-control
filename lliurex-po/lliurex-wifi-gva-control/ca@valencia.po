#: ../lliurex-wifi-gva-control.install/ui/rsrc/ApplicationOptions.qml:32
msgid "Help"
msgstr "Ajuda"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/CustomPopup.qml:71
msgid "Apply changes. Wait a moment..."
msgstr "S’estan aplicant els canvis. Espereu un moment..."

#: ../lliurex-wifi-gva-control.install/ui/rsrc/CustomPopup.qml:73
msgid "Restoring previous values. Wait a moment..."
msgstr "S’estan restaurant els valors anteriors. Espereu un moment..."

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:32
msgid "WIFI GVA connection configuration"
msgstr "Configuració de la connexió WIFI GVA"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:50
msgid "Activate automatic connection to the Wifi (WIFI_EDU) at login"
msgstr ""
"Activar la connexió automàtica a la wifi (WIFI_EDU) en l'inici de sessió"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:65
msgid "Access mode:"
msgstr "Mode d'accés:"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:86
msgid "Access using user credentials"
msgstr "Accés mitjançant credencials d'usuari"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:97
msgid "Automatic login with alumnat user"
msgstr "Inici automàtic de sessió amb usuari alumnat"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:108
msgid "Access using Easy-Login"
msgstr "Accés mitjançant Easy-Login"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:127
msgid "Password:"
msgstr "Contrasenya:"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:179
msgid "Click to edit password"
msgstr "Feu clic per a editar la contrasenya"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:180
msgid "Click to cancel password editing"
msgstr "Feu clic per a cancel·lar l'edició de la contrasenya"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:195
msgid "Click to clear password"
msgstr "Feu clic per a esborrar la contrasenya"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:205
msgid "Confirm password:"
msgstr "Confirmar la contrasenya:"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:274
msgid "Apply"
msgstr "Aplica"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:293
#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:312
#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:338
msgid "Cancel"
msgstr "Cancel·la"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:307
msgid ""
"The are pending changes to apply.\n"
"Do you want apply the changes or discard them?"
msgstr ""
"Hi ha canvis pendents d’aplicar.\n"
"Voleu aplicar els canvis o descartar-los?"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:309
msgid "Discard"
msgstr "Descarta"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:333
msgid "Do you want to delete the password for alumnat user?"
msgstr "Voleu esborrar la contrasenya per a l'usuari alumnat?"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:336
#: ../lliurex-wifi-gva-control.install/ui/rsrc/ChangesDialog.qml:76
msgid "Accept"
msgstr "Accepta"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:355
msgid ""
"It is necessary to activate the integration with Digital Identitiy to be "
"able to log in with WIFI GVA"
msgstr ""
"És necessari activar la integració amb la Identitat Digital per a poder "
"iniciar sessió amb la WIFI GVA"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:358
msgid "Close"
msgstr "Tanca"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:377
msgid "Changes applied successfully"
msgstr "Els canvis s’ha aplicat correctament"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:379
msgid ""
"It is necessary to activate the integration with Digital Identity to be able "
"to log in with WIFI GVA"
msgstr ""
"És necessari activar la integració amb la Identitat Digital per a poder "
"iniciar sessió amb la WIFI GVA"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:381
msgid "Error changing WIFI settings"
msgstr "S’ha produït un error canviant la configuració de la wifi"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:383
msgid "Error changing password for autologin"
msgstr ""
"S’ha produït un error canviant la contrasenya per a inici de sessió automàtic"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:385
msgid "Error changing autogin activation"
msgstr ""
"S’ha produït un error canviant l'activació de l'inici de sessió automàtic"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:387
msgid "Multiple errors have ocurred while applying changes"
msgstr "S'han produït diversos errors en aplicar els canvis"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:389
msgid "Passwords must match"
msgstr "Les contrasenyes han de coincidir"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:391
msgid "You must enter a password"
msgstr "Introduïu una contrasenya"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:393
msgid "Error reloading configuration"
msgstr "S’ha produït un error recarregant la configuració"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:441
msgid "Click to show password"
msgstr "Feu clic per a mostrar la contrasenya"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:442
msgid "Click to hide password"
msgstr "Feu clic per a ocultar la contrasenya"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/Loading.qml:60
msgid "Loading. Wait a moment..."
msgstr "S’està carregant. Espereu un moment..."

#: ../lliurex-wifi-gva-control.install/ui/rsrc/Loading.qml:71
msgid "Error loading configuration"
msgstr "S’ha produït un error carregant la configuració"
