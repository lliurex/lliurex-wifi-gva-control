#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:303
#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:330
msgid "Cancel"
msgstr "Cancel·la"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:296
#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:323
#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:346
msgid "Wifi configuration"
msgstr "Configuració wifi"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:298
msgid ""
"The are pending changes to apply.\n"
"Do you want apply the changes or discard them?"
msgstr ""
"Hi ha canvis pendents d’aplicar.\n"
"Voleu aplicar els canvis o descartar-los?"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:300
msgid "Discard"
msgstr "Descarta"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:325
msgid "Do you want to delete the password for alumnat user?"
msgstr "Voleu esborrar la contrasenya per a l'usuari alumnat?"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:328
msgid "Accept"
msgstr "Accepta"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:348
msgid ""
"It is necessary to activate the integration with Digital Identitiy to be "
"able to log in with WIFI GVA"
msgstr ""
"És necessari activar la integració amb la Identitat Digital per a poder "
"iniciar sessió amb la WIFI GVA"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:351
msgid "Close"
msgstr "Tanca"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:369
msgid "Changes applied successfully"
msgstr "Els canvis s’ha aplicat correctament"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:371
msgid ""
"It is necessary to activate the integration with Digital Identity to be able "
"to log in with WIFI GVA"
msgstr ""
"És necessari activar la integració amb la Identitat Digital per a poder "
"iniciar sessió amb la WIFI GVA"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:373
msgid "Error changing WIFI settings"
msgstr "S’ha produït un error canviant la configuració de la wifi"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:375
msgid "Error changing password for autologin"
msgstr ""
"S’ha produït un error canviant la contrasenya per a inici de sessió automàtic"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:377
msgid "Error changing autogin activation"
msgstr ""
"S’ha produït un error canviant l'activació de l'inici de sessió automàtic"

