msgid "Passwords must match"
msgstr "Les contrasenyes han de coincidir"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:383
msgid "You must enter a password"
msgstr "Introduïu una contrasenya"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:385
msgid "Error reloading configuration"
msgstr "S’ha produït un error recarregant la configuració"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:429
msgid "Click to show password"
msgstr "Feu clic per a mostrar la contrasenya"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/WifiOptions.qml:430
msgid "Click to hide password"
msgstr "Feu clic per a ocultar la contrasenya"

#: ../lliurex-wifi-gva-control.install/ui/rsrc/Loading.qml:60
msgid "Loading. Wait a moment..."
msgstr "S’està carregant. Espereu un moment..."

#: ../lliurex-wifi-gva-control.install/ui/rsrc/Loading.qml:71
msgid "Error loading configuration"
msgstr "S’ha produït un error carregant la configuració"
